// ============================================================
// CFB Betting Model — Database Schema
// ============================================================
// This file is the single source of truth for the database structure.
// Run `npx prisma migrate dev` after editing this to apply changes.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- TEAM IDENTITY (build this first, get it right) ----------

model Team {
  id            String   @id @default(cuid())
  canonicalName String   @unique
  // short betting-style acronym for tight UI spots (e.g. "MISS ST", "NMSU"),
  // from CFBD /teams .abbreviation — backfilled by scripts/backfillTeamMeta.ts
  abbreviation  String?
  conference    String?
  // 'fbs' for teams we rate and predict; 'fcs' / 'ii' / 'iii' for opponents
  // that only exist here so FBS-vs-lower-division games have real team IDs.
  // Non-fbs teams never get ratings or predictions.
  classification String  @default("fbs")
  // home-stadium location + metadata, backfilled from CFBD /teams (scripts/backfillTeamMeta.ts).
  // lat/lng/timezone feed the situational 'travel' flag; elevation may matter for totals later.
  timezone      String?
  lat           Float?
  lng           Float?
  elevationM    Float?
  // brand assets for the eventual web UI
  logoLight     String?
  logoDark      String?
  color         String?
  altColor      String?
  espnId        Int?      // ESPN's numeric team id — for the injuries feed

  aliases         TeamSourceAlias[]
  ratingsWeekly   TeamRatingWeekly[]
  rankings        Ranking[]
  homeGames       Game[]              @relation("HomeTeam")
  awayGames       Game[]              @relation("AwayTeam")
  injuries        Injury[]
  gameFlags       GameFlag[]
  rivalriesAsA    Rivalry[]           @relation("RivalryTeamA")
  rivalriesAsB    Rivalry[]           @relation("RivalryTeamB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// This table is the whole point: every source (CFBD, Odds API, ESPN) names
// teams differently. Every other table below references Team.id ONLY —
// never a raw name string — so a naming mismatch can only ever break here,
// in one place, instead of silently corrupting data everywhere downstream.
model TeamSourceAlias {
  id         String  @id @default(cuid())
  teamId     String
  team       Team    @relation(fields: [teamId], references: [id])
  source     String  // 'cfbd' | 'odds_api' | 'espn'
  sourceName String  // the exact string that source uses for this team
  confidence String  @default("needs_review") // 'confirmed' | 'auto_matched' | 'needs_review'

  createdAt DateTime @default(now())

  @@unique([source, sourceName])
  @@index([teamId])
}

model Rivalry {
  id       String @id @default(cuid())
  teamAId  String
  teamA    Team   @relation("RivalryTeamA", fields: [teamAId], references: [id])
  teamBId  String
  teamB    Team   @relation("RivalryTeamB", fields: [teamBId], references: [id])
  name     String // e.g. "Iron Bowl"
}

// ---------- POLLS (AP / Coaches), one snapshot per week, from CFBD /rankings ----------

model Ranking {
  id              String @id @default(cuid())
  season          Int
  week            Int
  poll            String // 'ap' | 'coaches'
  teamId          String
  team            Team   @relation(fields: [teamId], references: [id])
  rank            Int
  points          Int?
  firstPlaceVotes Int?

  @@unique([season, week, poll, teamId])
  @@index([season, week])
}

// ---------- WEEKLY RATINGS (refreshed Tuesdays, per source SP+ cadence) ----------

model TeamRatingWeekly {
  id                     String   @id @default(cuid())
  teamId                 String
  team                   Team     @relation(fields: [teamId], references: [id])
  season                 Int
  week                   Int
  spPlusOverall          Float?
  spPlusOffense          Float?
  spPlusDefense          Float?
  // where the SP+ numbers came from: 'cfbd' (ESPN FBS feed) or 'billc'
  // (Connelly's full-universe sheet, re-centered onto CFBD's scale — used
  // for FCS teams CFBD doesn't rate). See scripts/loadBillcRatings.ts.
  spPlusSource           String?
  // SRS (Simple Rating System, CFBD /ratings/srs): opponent-adjusted scoring
  // margin on the same points scale as spPlusOverall. Single number — SRS has
  // no offense/defense split, so it feeds the spread model only, not totals.
  // Kept alongside SP+ on purpose: where the two disagree is itself a signal
  // (see docs/INTERPRETATION_GUIDE.md).
  srs                    Float?
  avgPossessionsPerGame  Float?
  pulledAt               DateTime @default(now())

  @@unique([teamId, season, week])
  @@index([season, week])
}

// ---------- SCHEDULE / RESULTS ----------

model Game {
  id          String   @id @default(cuid())
  season      Int
  week        Int
  homeTeamId  String
  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId  String
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  kickoffTime DateTime
  neutralSite Boolean  @default(false) // true -> spread model applies NO home-field advantage
  venue       String?
  venueId     Int?
  venueLat    Float?
  venueLng    Float?
  indoor      Boolean  @default(false) // dome/retractable-closed -> weather doesn't apply
  homeScore   Int?
  awayScore   Int?
  status      String   @default("scheduled") // 'scheduled' | 'final'
  broadcast   String?  // TV network (e.g. "ABC", "ESPN") from CFBD /games/media

  lines             Line[]
  weather           Weather[]
  injuries          Injury[]
  modelPredictions  ModelPrediction[]
  gameFlags         GameFlag[]
  picks             Pick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // natural key: one game per matchup per week. Makes the schedule pull idempotent.
  @@unique([season, week, homeTeamId, awayTeamId])
  @@index([season, week])
}

// ---------- LINES (snapshotted, never overwritten — this is what makes CLV possible) ----------

model Line {
  id           String   @id @default(cuid())
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id])
  sportsbook   String
  market       String   // 'spread' | 'total' | 'h2h'
  lineValue    Float
  price        Int?     // American odds, e.g. -110
  snapshotType String   // 'open' | 'daily' | 'close'
  // 'odds_api' = live snapshots from The Odds API (current weeks);
  // 'cfbd'     = historical open/close from CFBD /lines (backfill, past weeks)
  source       String   @default("odds_api")
  capturedAt   DateTime @default(now())

  @@index([gameId])
}

// ---------- WEATHER ----------

model Weather {
  id               String   @id @default(cuid())
  gameId           String
  game             Game     @relation(fields: [gameId], references: [id])
  windMph          Float?
  precipProbability Float?
  tempF            Float?
  pulledAt         DateTime @default(now())

  @@index([gameId])
}

// ---------- INJURIES (impact/starter-level players only — filtered by design) ----------

model Injury {
  id             String   @id @default(cuid())
  gameId         String
  game           Game     @relation(fields: [gameId], references: [id])
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  playerName     String
  position       String?
  isImpactPlayer Boolean  @default(true)
  status         String   // 'out' | 'doubtful' | 'questionable'
  updatedAt      DateTime @updatedAt

  @@index([gameId])
}

// ---------- MODEL OUTPUT ----------

model ModelPrediction {
  id                    String   @id @default(cuid())
  gameId                String
  game                  Game     @relation(fields: [gameId], references: [id])
  // Two independent spread models, both stored every pull so they can be
  // compared to each other and to the market (see docs/INTERPRETATION_GUIDE.md).
  predictedSpreadSpPlus Float?   // (home_SP+overall - away_SP+overall) + HFA
  predictedSpreadSrs    Float?   // (home_SRS       - away_SRS)         + HFA
  predictedTotal        Float?   // SP+ efficiency -> points-per-possession -> pace
  homeExpectedPpp       Float?
  awayExpectedPpp       Float?
  predictedPossessions  Float?
  generatedAt           DateTime @default(now())

  @@index([gameId])
}

// ---------- SITUATIONAL FLAGS ----------

model GameFlag {
  id       String  @id @default(cuid())
  gameId   String
  game     Game    @relation(fields: [gameId], references: [id])
  teamId   String
  team     Team    @relation(fields: [teamId], references: [id])
  flagType String  // 'lookahead' | 'letdown' | 'short_week' | 'off_bye' | 'travel' | 'revenge'
  detail   Json?   // e.g. { "distanceMiles": 1800, "tzChange": 2 }

  @@index([gameId])
}

// ---------- PICKS (the actual output — logged, then graded after the game) ----------

model Pick {
  id            String    @id @default(cuid())
  gameId        String
  game          Game      @relation(fields: [gameId], references: [id])
  market        String    // 'spread' | 'total'
  method        String    @default("sp_plus") // 'sp_plus' | 'srs' | 'consensus' — which model produced modelLine
  modelLine     Float
  marketLine    Float
  edge          Float
  flagsPresent  Json?     // array of flag_types active at pick time
  suggestedAt   DateTime  @default(now())

  closingLine   Float?
  actualResult  Float?
  atsResult     String?   // 'win' | 'loss' | 'push'
  gradedAt      DateTime?

  // one logged pick per game per market — first time it qualifies, captured as-is
  @@unique([gameId, market])
  @@index([gameId])
}
