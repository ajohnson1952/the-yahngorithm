# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Neon Postgres ---------------------------------------------------------
# From your Neon project dashboard -> "Connection string".
# DATABASE_URL: the POOLED string (WITH "-pooler" in the host) — what the
#   app queries with at runtime. On Vercel, concurrent serverless function
#   instances each open their own connection; pooling (PgBouncer) is what
#   keeps that from exhausting Postgres's connection limit under traffic.
# DIRECT_URL: the DIRECT string (WITHOUT "-pooler") — migrations only
#   (`prisma migrate deploy`/`dev`). Migration tooling's advisory locks and
#   DDL don't play well through a transaction-mode pooler.
# Local dev: both can just point at the direct URL — no pooling need with a
# single dev process, and schema.prisma requires DIRECT_URL to be set
# whenever DATABASE_URL is (even if they're identical).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- CollegeFootballData (CFBD) ------------------------------------------
# Free key, arrives by email: https://collegefootballdata.com/key
CFBD_API_KEY=""

# --- The Odds API --------------------------------------------------------
# Free key: https://the-odds-api.com
# Use a BRAND NEW account — do NOT reuse the Cavepicks key (shared monthly credits).
ODDS_API_KEY=""

# --- Neon API (optional) ----------------------------------------------
# Personal API key from https://console.neon.tech/app/settings/api-keys
# Only used for compute/usage inspection + settings (autosuspend, CU limits),
# never by the app or the pipeline. Leave blank if you don't need it.
NEON_API_KEY=""

# --- Cloudflare Web Analytics (optional, prod only) --------------------
# Token from Cloudflare dashboard → Analytics & Logs → Web Analytics →
# add site (hostname) → "JS snippet" (the data-cf-beacon token).
# Set it in the VERCEL env, not here — local traffic isn't worth counting.
# When unset, no analytics script is injected.
CF_BEACON_TOKEN=""

# --- Admin / rankings gate ---------------------------------------------
# ADMIN_PASSWORD: the password for /admin and /rankings. If unset it falls
#   back to the public default "2142" — set a real one in any deployed env.
# ADMIN_SESSION_SECRET: long random string so the auth cookie can't be
#   forged off-box. Generate with:  openssl rand -hex 32
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
